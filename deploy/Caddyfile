# Caddy gets a certificate for each name listed here automatically, and redirects
# www to the bare domain. To move the site to a different host, point the DNS at
# the new server and change nothing here.
pdb2print.org, www.pdb2print.org {
	reverse_proxy app:7860 {
		# Builds stream progress over Server-Sent Events. Without these the proxy
		# buffers the stream and the progress bar sits at zero until the build
		# finishes, which looks exactly like the app having hung.
		flush_interval -1

		# A large complex can take minutes. The default read timeout would cut
		# the connection mid-build and the user would see a failure on a build
		# that was working fine.
		transport http {
			read_timeout 30m
		}
	}

	# Uploaded structures are small, but a generous cap avoids a confusing
	# rejection on a big mmCIF.
	request_body {
		max_size 100MB
	}

	# Compress everything except the two Server-Sent Events endpoints.
	#
	# `encode gzip` on its own matches by content type, and `text/event-stream`
	# matches `text/*` — so the progress stream was being compressed. Caddy does
	# pass a flush through the encoder, so this is not known to have broken
	# anything; it is excluded because it is the one component on the server path
	# that is not on the local one, it sits directly on the bytes that go quiet
	# when the site freezes, and gzip buys nothing on a stream of hundred-byte
	# JSON frames. If freezes continue after this, the proxy is exonerated and
	# the cause is upstream.
	@compressible {
		not path /api/generate /api/stand
	}
	encode @compressible gzip

	header {
		# Standard hardening. No CSP here because the front end loads
		# model-viewer from unpkg; add one only after checking it in a browser.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
