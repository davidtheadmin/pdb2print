# Keep the build context small and the image reproducible.
.git
.venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
_to_delete

# Local scratch that must never define the image's behaviour
1TUP.cif
commit-v3.ps1

# Docs are for the repo, not the running app. The cache is NOT excluded — the
# pre-generated entries are the whole point of shipping it.
docs/

# Photo and video originals. Not needed by the app and 78 MB of build context.
media/

# The *runtime* cache is a different thing from the repo-root cache/, and it must
# never enter the build context. deploy/cache is the host side of the bind mount
# in docker-compose.yml, so on a live server it is every entry the site has ever
# built — 7.9 GB on 2026-07-30. Docker copies all of it into the daemon and bakes
# it into the image at /app/deploy/cache, where nothing reads it: the mount lands
# on /app/cache, not there. It cost ~28 minutes of a 33-minute deploy, and it
# grows every time somebody builds a model.
deploy/cache/